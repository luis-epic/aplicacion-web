{
  "name": "@opeconca/field",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:platform": "concurrently --kill-others --names api,web \"pnpm --filter @opeconca/api dev\" \"pnpm --filter @opeconca/web dev\"",
    "dev:all": "concurrently --kill-others --names field,platform \"pnpm run dev\" \"pnpm run dev:platform\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "mvp:setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mvp.ps1",
    "mvp:up": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mvp.ps1 -SkipBuild",
    "mvp:down": "docker compose --env-file .env -f infra/compose.mvp.yaml down",
    "mvp:status": "docker compose --env-file .env -f infra/compose.mvp.yaml ps",
    "build:all": "pnpm run build && turbo run build",
    "lint:all": "pnpm run lint && turbo run lint",
    "typecheck:all": "pnpm run typecheck && turbo run typecheck"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.4",
    "oxlint": "1.71.0",
    "pnpm": "11.17.0",
    "turbo": "2.10.7",
    "typescript": "6.0.2",
    "vite": "8.1.1"
  }
}
