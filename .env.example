NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0

POSTGRES_DB=opeconca
POSTGRES_USER=opeconca
POSTGRES_PASSWORD=replace-with-a-local-password
# Producción: referencias OCI completas nombre@sha256:digest; no se aceptan tags mutables.
POSTGRES_IMAGE=
API_MIGRATION_IMAGE=
API_IMAGE=
WEB_IMAGE=
FIELD_IMAGE=
# Directorio corporativo read-only montado únicamente en la API; portal y PWA descargan portadas con autorización.
PUBLICATION_MEDIA_PATH=
PUBLICATION_MEDIA_ROOT=/app/media/publications
DATABASE_URL=postgresql://opeconca:replace-with-a-local-password@localhost:5432/opeconca?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

LOG_LEVEL=debug
SERVICE_VERSION=development
METRICS_ENABLED=false
# METRICS_TOKEN debe contener al menos 32 caracteres cuando METRICS_ENABLED=true.
METRICS_TOKEN=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-16-characters
ADMIN_NAME=Administrador OPECONCA
# Sólo para el comando productivo admin:bootstrap; no habilita creación automática al arrancar.
ADMIN_BOOTSTRAP_CONFIRM=

APP_URL=http://localhost:3000
FIELD_APP_URL=http://localhost:5173
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EMAIL_API_KEY=
